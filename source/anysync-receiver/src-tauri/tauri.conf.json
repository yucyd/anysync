{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnySync Receiver",
  "version": "0.1.0",
  "identifier": "dev.anysync.receiver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnySync Receiver",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
